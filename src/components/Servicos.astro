---
import VisualServico from './VisualServico.astro'
import { SECAO_SERVICOS, SERVICOS } from '../content/site'
---

<section id="servicos" class="servicos" data-servicos>
  <div class="cabeca container" data-revelar>
    <p class="etiqueta">{SECAO_SERVICOS.etiqueta}</p>
    <h2 class="titulo-secao">
      {SECAO_SERVICOS.titulo}
      <span class="destaque">{SECAO_SERVICOS.tituloDestaque}</span>
    </h2>
    <p class="lead">{SECAO_SERVICOS.descricao}</p>
  </div>

  <!-- No desktop esta faixa fica presa na tela e os cards andam para o lado. -->
  <div class="pino" data-servicos-pino>
    <div class="trilho" data-servicos-trilho>
      {
        SERVICOS.map((s) => (
          <article class="card" data-servico-card>
            <VisualServico id={s.id} />
            <div class="info">
              <span class="codigo">{s.codigo}</span>
              <h3>{s.titulo}</h3>
              <p class="chamada">{s.chamada}</p>
              <p class="descricao">{s.descricao}</p>
              <ul>
                {s.itens.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="contador container" aria-hidden="true">
      <span class="numero"><b data-servicos-atual>01</b> / {String(SERVICOS.length).padStart(2, '0')}</span>
      <div class="barra"><span data-servicos-barra></span></div>
      <span class="dica" data-servicos-dica>Continue rolando <i>→</i></span>
    </div>
  </div>
</section>

<style>
  .servicos {
    background: var(--canvas);
    padding-top: var(--secao);
  }

  .cabeca {
    max-width: var(--max-largo);
    display: grid;
    gap: 16px;
    margin-bottom: clamp(32px, 5vh, 56px);
  }

  .cabeca .lead {
    max-width: 620px;
  }

  .pino {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: 32px;
    padding-bottom: 48px;
    overflow: hidden;
  }

  .trilho {
    display: flex;
    gap: 20px;
    padding-inline: max(var(--gutter), calc((100vw - var(--max-largo)) / 2 + var(--gutter)));
    width: max-content;
    will-change: transform;
  }

  @media (min-width: 901px) {
    .pino {
      min-height: 100svh;
      padding-top: var(--nav-altura);
    }
  }

  /* Tela baixa (notebook): tira o parágrafo longo para o card caber inteiro. */
  @media (min-width: 901px) and (max-height: 860px) {
    .descricao {
      display: none;
    }
  }

  .card {
    flex: none;
    width: min(440px, 82vw);
    display: grid;
    align-content: start;
    gap: 22px;
    padding: 14px 14px 28px;
    border-radius: var(--raio-card);
    background: var(--branco);
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 30px 60px -30px rgb(18 99 241 / 0.35);
  }

  .info {
    display: grid;
    gap: 10px;
    padding-inline: 12px;
  }

  .codigo {
    font-family: var(--fonte-mono);
    font-size: 12px;
    color: var(--azul);
  }

  h3 {
    font-size: var(--t-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-titulo);
    line-height: 1.15;
  }

  .chamada {
    font-weight: 500;
    color: var(--tinta);
  }

  .descricao {
    font-size: 15px;
    color: var(--tinta-3);
    line-height: 1.55;
  }

  ul {
    list-style: none;
    display: grid;
    gap: 6px;
    margin-top: 4px;
    font-size: 14px;
    color: var(--tinta-2);
  }

  li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  li::before {
    content: '';
    flex: none;
    width: 14px;
    height: 8px;
    border-left: 2px solid var(--azul);
    border-bottom: 2px solid var(--azul);
    transform: rotate(-45deg) translateY(-2px);
  }

  /* Contador + dica: deixam claro que a faixa anda para o lado com o scroll. */
  .contador {
    max-width: var(--max-largo);
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .numero {
    font-family: var(--fonte-mono);
    font-size: 13px;
    color: var(--tinta-3);
    white-space: nowrap;
  }

  .numero b {
    color: var(--azul);
    font-weight: 600;
  }

  .dica {
    font-size: 13px;
    color: var(--tinta-3);
    white-space: nowrap;
    transition: opacity 0.4s;
  }

  .dica i {
    display: inline-block;
    font-style: normal;
    color: var(--azul);
    animation: empurrar 1.4s var(--ease) infinite;
  }

  @keyframes empurrar {
    50% {
      transform: translateX(5px);
    }
  }

  .barra {
    flex: 1;
    height: 2px;
    background: var(--linha);
    border-radius: 2px;
    overflow: hidden;
  }

  .barra span {
    display: block;
    height: 100%;
    background: var(--azul);
    transform-origin: left;
    transform: scaleX(0);
  }

  /*
   * Sem o motion (Windows com "efeitos de animação" desligado, ou JS falhou),
   * o trilho não anda sozinho — vira uma grade com os 6 cards visíveis,
   * senão os cards do fim ficariam inalcançáveis.
   */
  @media (min-width: 901px) {
    :global(html:not(.motion)) .trilho {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      width: 100%;
      max-width: var(--max-largo);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    :global(html:not(.motion)) .card {
      width: auto;
    }

    :global(html:not(.motion)) .descricao {
      display: block;
    }

    :global(html:not(.motion)) .contador {
      display: none;
    }
  }

  /* Celular: sem trilho horizontal preso — vira um carrossel de arrastar. */
  @media (max-width: 900px) {
    .trilho {
      width: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-bottom: 8px;
    }

    .trilho::-webkit-scrollbar {
      display: none;
    }

    .card {
      scroll-snap-align: center;
    }

    .contador {
      display: none;
    }
  }
</style>

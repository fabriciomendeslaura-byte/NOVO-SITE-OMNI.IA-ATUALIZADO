---
import { FAIXA } from '../content/site'
---

<div class="faixa" aria-hidden="true" data-faixa>
  {
    [0, 1].map(() => (
      <div class="trilho" data-faixa-trilho>
        {FAIXA.map((item) => (
          <span>
            {item}
            <i />
          </span>
        ))}
      </div>
    ))
  }
</div>

<style>
  .faixa {
    display: flex;
    overflow: hidden;
    padding-block: 28px;
    background: var(--branco);
    border-block: 1px solid rgb(0 0 0 / 0.05);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .trilho {
    display: flex;
    flex: none;
    will-change: transform;
  }

  .trilho span {
    display: inline-flex;
    align-items: center;
    gap: 40px;
    padding-right: 40px;
    font-size: clamp(22px, 3vw, 40px);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--tinta);
  }

  .trilho span:nth-child(even) {
    color: transparent;
    -webkit-text-stroke: 1.2px var(--azul);
  }

  .trilho i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--azul);
  }
</style>

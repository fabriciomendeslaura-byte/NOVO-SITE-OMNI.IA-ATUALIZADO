---
import { EMPRESA, LINKS, linkWhatsApp } from '../content/site'

const ano = new Date().getFullYear()
---

<footer class="rodape">
  <div class="container-largo">
    <div class="colunas">
      <div class="sobre">
        <p class="marca">OMNI<b>.IA</b></p>
        <p>Engenharia de software e IA.<br />{EMPRESA.local}.</p>
      </div>

      <div>
        <h2>Soluções</h2>
        <ul>
          <li><a href="/#servicos">Software sob medida</a></li>
          <li><a href="/#agentes">Agentes de IA</a></li>
          <li><a href="/#servicos">Automações</a></li>
          <li><a href="/#engenharia">Infraestrutura</a></li>
        </ul>
      </div>

      <div>
        <h2>Produtos</h2>
        <ul>
          <li><a href={LINKS.omnizap} target="_blank" rel="noopener noreferrer">OmniZap</a></li>
          <li><a href={LINKS.cliqueAgenda} target="_blank" rel="noopener noreferrer">Clique Agenda</a></li>
        </ul>
      </div>

      <div>
        <h2>Contato</h2>
        <ul>
          <li><a href={linkWhatsApp()} target="_blank" rel="noopener noreferrer">{EMPRESA.whatsappExibicao}</a></li>
          <li><a href={`mailto:${EMPRESA.email}`}>{EMPRESA.email}</a></li>
          <li><a href={EMPRESA.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
        </ul>
      </div>
    </div>

    <p class="gigante" aria-hidden="true" data-gigante>
      {'OMNI.IA'.split('').map((letra) => <span>{letra}</span>)}
    </p>

    <div class="legal">
      <p>© {ano} {EMPRESA.razao}. Todos os direitos reservados.</p>
      <a href="/privacidade">Política de Privacidade</a>
    </div>
  </div>
</footer>

<style>
  .rodape {
    background: var(--canvas);
    padding-top: 80px;
    font-size: 12px;
    color: var(--tinta-3);
    overflow: hidden;
  }

  .colunas {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 32px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--linha);
  }

  .marca {
    font-size: 20px;
    font-weight: 700;
    color: var(--tinta);
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .marca b {
    color: var(--azul);
  }

  .sobre p:last-child {
    font-size: 14px;
    line-height: 1.5;
  }

  h2 {
    font-size: 12px;
    font-weight: 600;
    color: var(--tinta);
    margin-bottom: 10px;
  }

  ul {
    list-style: none;
    display: grid;
    gap: 8px;
  }

  a:hover {
    color: var(--tinta);
    text-decoration: underline;
  }

  /* Assinatura gigante — as letras sobem uma a uma quando o rodapé entra. */
  .gigante {
    display: flex;
    justify-content: center;
    overflow: hidden;
    font-size: clamp(64px, 18.5vw, 290px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    margin-top: 32px;
    padding-bottom: 0.04em;
    background: linear-gradient(180deg, var(--azul) 0%, var(--azul-profundo) 70%, transparent 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
  }

  .gigante span {
    display: inline-block;
    background: inherit;
    -webkit-background-clip: text;
    background-clip: text;
  }

  .legal {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px 28px;
  }

  @media (max-width: 760px) {
    .colunas {
      grid-template-columns: 1fr 1fr;
    }

    .sobre {
      grid-column: 1 / -1;
    }

    .legal {
      flex-direction: column;
    }
  }
</style>

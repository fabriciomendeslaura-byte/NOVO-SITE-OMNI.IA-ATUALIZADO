---
import '../styles/global.css'
import { EMPRESA, LINKS } from '../content/site'

interface Props {
  titulo?: string
  descricao?: string
}

const {
  titulo = 'OMNI.IA — Software, Agentes de IA e Automação para empresas',
  descricao = 'Engenharia de software e IA no Rio de Janeiro. Software sob medida, agentes de IA, automações, OmniZap (IA no WhatsApp) e Clique Agenda (agendamento online).',
} = Astro.props

const urlCanonica = new URL(Astro.url.pathname, Astro.site)

/** Dados estruturados: ajudam o Google e as IAs a entender quem é a empresa e o que ela vende. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: EMPRESA.nome,
      legalName: EMPRESA.razao,
      url: Astro.site?.toString(),
      logo: new URL('/favicon.png', Astro.site).toString(),
      email: EMPRESA.email,
      telephone: EMPRESA.whatsappExibicao,
      sameAs: [EMPRESA.instagram],
      address: { '@type': 'PostalAddress', addressLocality: 'Rio de Janeiro', addressCountry: 'BR' },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'OmniZap',
      applicationCategory: 'BusinessApplication',
      description: 'Agente de IA no WhatsApp com CRM, follow-up automático e agendamento.',
      url: LINKS.omnizap,
      publisher: { '@type': 'Organization', name: EMPRESA.nome },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Clique Agenda',
      applicationCategory: 'BusinessApplication',
      description: 'Agendamento online para negócios de hora marcada, com confirmação e lembrete por WhatsApp.',
      url: LINKS.cliqueAgenda,
      publisher: { '@type': 'Organization', name: EMPRESA.nome },
    },
  ],
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#f5f5f7" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      Liga o modo animado ANTES da primeira pintura (sem "piscar" o conteúdo).
      Plano B: se o script de motion não carregar em 4s, tira a classe e o
      conteúdo aparece normal — animação nunca pode esconder o texto de vez.
    -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion')
        setTimeout(function () {
          if (!window.__motionOk) document.documentElement.classList.remove('motion')
        }, 4000)
      }
    </script>
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <div class="progresso" aria-hidden="true"><span></span></div>
    <slot />
  </body>
</html>

<style>
  .pular {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 200;
    padding: 10px 16px;
    border-radius: var(--raio-pilula);
    background: var(--tinta);
    color: var(--branco);
    transform: translateY(-200%);
  }

  .pular:focus {
    transform: none;
  }

  /* Barra de leitura no topo — preenchida pelo script de motion. */
  .progresso {
    position: fixed;
    inset: 0 0 auto;
    height: 2px;
    z-index: 120;
    pointer-events: none;
  }

  .progresso span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--azul-profundo), var(--azul), var(--azul-ceu));
    transform-origin: left;
    transform: scaleX(var(--progresso, 0));
  }
</style>
